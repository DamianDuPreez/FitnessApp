rules_version = '2';

// Each person can only read and write their own data, stored under users/{their uid}.
// Nothing else in the database is accessible.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collection in ['workouts', 'sets', 'exercises', 'achievements', 'settings'];
    }
  }
}
